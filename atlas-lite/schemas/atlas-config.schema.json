{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.x/schemas/atlas-lite-config.schema.json",
  "title": "Atlas Lite Configuration (atlas.yml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repos", "pairs"],
  "properties": {
    "version":   { "type": "integer", "const": 1 },
    "bitbucket": { "$ref": "#/$defs/Bitbucket" },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Repo" }
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Pair" }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": true
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "db_path":    { "type": "string" },
        "site_path":  { "type": "string" },
        "cache_path": { "type": "string" }
      }
    },
    "mcp_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "ui_port":  { "type": "integer", "minimum": 1, "maximum": 65535 },
    "jira": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "Bitbucket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_url":        { "type": "string", "format": "uri" },
        "api_kind":        { "type": "string", "enum": ["server", "cloud"] },
        "auth":            { "type": "object", "additionalProperties": true },
        "browse_template": { "type": "string" }
      }
    },
    "Repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id":      { "type": "string", "minLength": 1 },
        "path":    { "type": "string", "minLength": 1 },
        "project": { "type": "string" },
        "branch":  { "type": "string" }
      }
    },
    "Pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scan_globs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "source": { "$ref": "#/$defs/SchemaRef" },
        "target": { "$ref": "#/$defs/SchemaRef" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SchemaRef" }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SchemaRef" }
        },
        "scan_globs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "scope_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [
              { "required": ["glob"] },
              { "required": ["filename_pattern"] }
            ],
            "properties": {
              "glob":             { "type": "string" },
              "filename_pattern": { "type": "string", "description": "Python regex with named groups (?P<country>...) (?P<clearing>...) etc. against the file's simple class name + .java" },
              "scope":            { "type": "object", "additionalProperties": true },
              "capture":          { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file", "kind"],
      "properties": {
        "name":      { "type": "string" },
        "file":      { "type": "string" },
        "kind":      { "type": "string", "enum": ["xsd", "json-schema", "proto", "fixedlen", "tagged", "java-class"] },
        "type_fqns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
