{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.x/schemas/manifest.schema.json",
  "title": "Atlas Manifest",
  "description": "Output of one extraction run for one (project, repo, pair). One file per pair, written to <repo>/target/atlas/manifests/<pair_id>.manifest.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "atlasVersion",
    "schemaVersion",
    "projectId",
    "repoId",
    "pairId",
    "git",
    "source",
    "target",
    "extractors",
    "edges",
    "checksum"
  ],
  "properties": {
    "atlasVersion": {
      "type": "string",
      "description": "Atlas release that produced this manifest (semver)."
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Manifest schema version. Bump on breaking change."
    },
    "projectId": { "type": "string", "minLength": 1 },
    "repoId":    { "type": "string", "minLength": 1 },
    "pairId":    { "type": "string", "minLength": 1 },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "sha", "branch"],
      "properties": {
        "repo":   { "type": "string" },
        "sha":    { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "branch": { "type": "string" }
      }
    },
    "source": { "$ref": "#/$defs/SchemaRef" },
    "target": { "$ref": "#/$defs/SchemaRef" },
    "extractors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id":      { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "options": { "type": "object", "additionalProperties": true }
        }
      },
      "description": "Extractors that ran and the options each was given."
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "https://atlas.x/schemas/edge.schema.json" }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filesScanned":   { "type": "integer", "minimum": 0 },
        "mappersDetected":{ "type": "integer", "minimum": 0 },
        "edgesEmitted":   { "type": "integer", "minimum": 0 },
        "byKind":         { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byMapperKind":   { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 over body excluding the checksum field. Determinism gate."
    }
  },
  "$defs": {
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schemaFile", "schemaKind"],
      "properties": {
        "name":       { "type": "string" },
        "schemaFile": { "type": "string" },
        "schemaKind": { "type": "string", "enum": ["xsd", "json-schema", "proto", "fixedlen", "tagged"] }
      }
    }
  }
}
